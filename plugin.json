{
  "id": "opss.whatdidisay",
  "name": "WhatdidIsay",
  "version": "0.2.0",
  "description": "Transcribe your talk into text records every time you use MicYou.",
  "license": "Unlicense",
  "runtime": "native",
  "entry": "WhatdidIsay.dll",
  "platforms": ["windows"],
  "arches": ["x86_64"],
  "apiVersion": 1,
  "capabilities": ["config.read", "config.write", "dsp.node"],
  "kind": "dsp",
  "dsp": { "insertAfter": "AEC" },
  "config": {
    "loadTiming": "device_connect"
  },
  "configSchema": {
    "fields": [
      {
        "key": "loadTiming",
        "fieldType": "select",
        "label": "模型加载时机",
        "default": "device_connect",
        "options": [
          { "value": "micyou_start", "label": "MicYou 启动时" },
          { "value": "device_connect", "label": "设备连接时" }
        ]
      }
    ]
  }
}
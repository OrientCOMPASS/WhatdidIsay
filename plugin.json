{
  "id": "opss.whatdidisay",
  "name": "WhatdidIsay",
  "version": "0.1.0",
  "description": "Transcribe your talk into text records every time you use MicYou.",
  "license": "Unlicense",
  "runtime": "native",
  "entry": "WhatdidIsay.dll",
  "platforms": ["windows"],
  "arches": ["x86_64"],
  "apiVersion": 1,
  "capabilities": ["config.read", "config.write", "dsp.node"],
  "kind": "dsp",
  "dsp": { "insertAfter": "AEC" },
  "config": {
    "loadTiming": "device_connect",
    "targetLanguage": "zh"
  },

    "fields": [
      {
        "key": "loadTiming",
        "fieldType": "select",
        "label": "模型加载时机",
        "default": "device_connect",
        "options": [
          { "value": "micyou_start", "label": "MicYou 启动时" },
          { "value": "device_connect", "label": "设备连接时" }
        ]
      },
      {
        "key": "targetLanguage",
        "fieldType": "select",

# ==========================================
# 插件运行时产生的数据与模型 (你关心的部分)
# ==========================================

# 忽略测试和运行产生的日志文件
log.txt

# 忽略语音转录记录文件夹
records/

# 忽略 Qwen3 ASR 模型文件夹 (体积很大，绝对不要提交到 Git)
sherpa-onnx-qwen3-asr-0.6B-int8/

# 如果你也下载了 VAD 模型到根目录，建议也忽略它
silero_vad.onnx


# ==========================================
# Rust 项目常规忽略项 (建议保留)
# ==========================================

# 忽略 Cargo 编译输出目录
target/

# 忽略编译生成的动态链接库产物 (根据你的系统可能是 .dll, .so 或 .dylib)
# 注意：如果你希望把编译好的 dll 提交到仓库供他人直接下载，请注释掉下面这行
*.dll
*.so
*.dylib

# 忽略 Cargo 锁文件 (如果你开发的是独立应用/插件，通常提交 Cargo.lock；如果是库，则忽略。这里建议保留提交，但列出以防你需要)
# Cargo.lock

# 忽略常见编辑器配置
.vscode/
.idea/
*.swp
*.swo
*~
.gitignore

# 忽略 macOS 系统文件
.DS_Store